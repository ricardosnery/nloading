{
    "name": "ricardosnery/nloading",
    "description": "Configurable loading overlay plugin for Filament panels.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "laravel",
        "livewire",
        "loading-overlay",
        "plugin"
    ],
    "homepage": "https://github.com/ricardosnery/nloading",
    "support": {
        "issues": "https://github.com/ricardosnery/nloading/issues",
        "source": "https://github.com/ricardosnery/nloading"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "RicardoSnery\\NLoading\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RicardoSnery\\NLoading\\NLoadingServiceProvider"
            ]
        }
    }
}
